<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>نظام إدارة الكونكريت والصب</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <h1>🏗️ نظام إدارة شركات الكونكريت والصب</h1>

  <h2>📊 لوحة الإدارة</h2>

  <p>
    إدارة الطلبات والحسابات والزبائن وعمليات الصب بسهولة.
  </p>

  <hr>

  <h3>📈 إحصائيات اليوم</h3>

  <ul>
    <li>🧾 طلبات الصب: <strong id="ordersCount">0</strong></li>

    <li>🏗️ كمية الكونكريت:
      <strong id="totalVolume">0</strong> م³
    </li>

    <li>💰 المقبوضات:
      <strong id="totalPaid">0</strong> د.ع
    </li>

    <li>💳 المبالغ المتبقية:
      <strong id="totalRemaining">0</strong> د.ع
    </li>
  </ul>

  <hr>

  <h3>🧾 إضافة طلب صب جديد</h3>

  <form id="orderForm">

    <label>👤 اسم الزبون</label>
    <input
      id="customer"
      type="text"
      placeholder="أدخل اسم الزبون"
    >

    <br><br>

    <label>📞 رقم الهاتف</label>
    <input
      id="phone"
      type="tel"
      placeholder="07xxxxxxxxx"
    >

    <br><br>

    <label>📍 موقع الصب</label>
    <input
      id="location"
      type="text"
      placeholder="عنوان موقع المشروع"
    >

    <br><br>

    <label>🏗️ كمية الكونكريت بالمتر المكعب</label>
    <input
      id="volume"
      type="number"
      min="1"
      placeholder="مثال: 20"
    >

    <br><br>

    <label>💰 السعر للمتر</label>
    <input
      id="price"
      type="number"
      min="0"
      placeholder="مثال: 75000"
    >

    <br><br>

    <label>💵 المبلغ المدفوع</label>
    <input
      id="paid"
      type="number"
      min="0"
      placeholder="المبلغ المدفوع"
    >

    <br><br>

    <label>📝 ملاحظات</label>
    <textarea
      id="notes"
      placeholder="ملاحظات الطلب"
    ></textarea>

    <br><br>

    <button type="button" onclick="addOrder()">
      💾 حفظ طلب الصب
    </button>

  </form>

  <hr>

  <h3>📋 آخر الطلبات</h3>

  <div id="ordersList">
    لا توجد طلبات حتى الآن.
  </div>

  <script src="app.js"></script>

</body>
</html>
